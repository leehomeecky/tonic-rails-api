{
  "name": "tonic-rails-api",
  "version": "0.0.1",
  "description": "Tonic Rails: multi-currency stablecoin wallet & FX sandbox API",
  "author": "meecky",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "test:cov": "jest --runInBand --coverage",
    "typeorm": "typeorm-ts-node-commonjs -d src/shared/config/db/data-source.ts",
    "migration:run": "yarn typeorm migration:run",
    "migration:revert": "yarn typeorm migration:revert",
    "migration:show": "yarn typeorm migration:show",
    "openapi:generate": "ts-node scripts/generate-openapi.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6",
    "@nestjs/swagger": "^11",
    "@nestjs/terminus": "^11",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.9",
    "helmet": "^8.3.0",
    "ioredis": "^5",
    "joi": "^18.3.1",
    "libphonenumber-js": "^1.13.15",
    "nestjs-pino": "^5.3.1",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.1",
    "pino": "^10",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "fast-check": "^4.10.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.2.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "rootDir": "src",
        "testRegex": ".*.spec.ts$",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "transform": {
          "^.+.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node"
      },
      {
        "displayName": "e2e",
        "rootDir": ".",
        "roots": [
          "<rootDir>/test"
        ],
        "testRegex": ".*.e2e-spec.ts$",
        "moduleFileExtensions": [
          "js",
          "json",
          "ts"
        ],
        "transform": {
          "^.+.(t|j)s$": "ts-jest"
        },
        "testEnvironment": "node",
        "globalSetup": "<rootDir>/test/utils/global-setup.ts",
        "globalTeardown": "<rootDir>/test/utils/global-teardown.ts",
        "setupFilesAfterEnv": [
          "<rootDir>/test/utils/setup-e2e.ts"
        ]
      }
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts",
      "!src/migrations/**",
      "!src/**/*.module.ts",
      "!src/shared/config/db/data-source.ts"
    ],
    "coverageDirectory": "coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
