# =============================================================================
# Tonic Rails API: environment template
# Works as-is with docker compose. For local runs: cp .env.example .env
# =============================================================================

# =============== | App | ====================
NODE_ENV=dev
PORT=9000
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# =============== | Postgres | ====================
DB_HOST=localhost
DB_PORT=5432
DB_USER=tonicrails
DB_PASSWORD=tonicrails
DB_NAME=tonicrails
DB_SSL=false
DB_RUN_MIGRATIONS=true
DB_POOL_SIZE=10
DB_LOGGING=false

# =============== | Redis (optional: the API degrades gracefully without it) | ====================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============== | FX | ====================
# openErApi (live, free, no key) | static (fixed table, offline)
FX_PROVIDER=openErApi
FX_PROVIDER_URL=https://open.er-api.com/v6/latest/USD
FX_PROVIDER_TIMEOUT_MS=3000
FX_CACHE_TTL_SECONDS=60
FX_REFRESH_ENABLED=true
FX_REFRESH_INTERVAL_SECONDS=300
# A live snapshot older than this is reported as LAST_KNOWN_GOOD (isStale: true)
FX_STALE_AFTER_SECONDS=900
# Never serve a live snapshot older than this; fall back to the static table instead
FX_MAX_STALENESS_SECONDS=86400

# =============== | Limits | ====================
MAX_TRANSACTION_AMOUNT_USD=1000000
IDEMPOTENCY_KEY_TTL_HOURS=24
THROTTLE_LIMIT=120
THROTTLE_TTL_SECONDS=60
