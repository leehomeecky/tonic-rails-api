        "summary": "Fetch a single transaction by id or reference",
        "tags": [
          "Transactions"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "HealthController_live",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "summary": "Liveness: the process is up",
        "tags": [
          "Health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "HealthController_ready",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The Health Check is successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {},
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "The Health Check is not successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "error"
                    },
                    "info": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "error": {
                      "type": "object",
                      "example": {
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      },
                      "nullable": true
                    },
                    "details": {
                      "type": "object",
                      "example": {
                        "database": {
                          "status": "up"
                        },
                        "redis": {
                          "status": "down",
                          "message": "Could not connect"
                        }
                      },
                      "additionalProperties": {
                        "type": "object",
                        "required": [
                          "status"
                        ],
                        "properties": {
                          "status": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Readiness: database reachable (Redis optional)",
        "tags": [
          "Health"
        ]
      }
    }
  },
  "info": {
    "title": "Tonic Rails API",
    "description": "Multi-currency stablecoin wallet sandbox: wallets, deposits, swaps, cross-border transfers and FX rates. Amounts are decimal strings with up to 6 decimal places. Money-moving POSTs require an Idempotency-Key header.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "FxRatesResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "base": {
                "type": "string",
                "enum": [
                  "cNGN",
                  "cGHS",
                  "cXAF",
                  "USDx",
                  "EURx"
                ],
                "description": "Supported stablecoin"
              },
              "source": {
                "type": "string",
                "enum": [
                  "LIVE",
                  "LAST_KNOWN_GOOD",
                  "STATIC"
                ]
              },
              "provider": {
                "type": "string"
              },
              "refreshedAt": {
                "type": "string",
                "description": "ISO-8601 UTC timestamp"
              },
              "isStale": {
                "type": "boolean"
              },
              "rates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "enum": [
                        "cNGN",
                        "cGHS",
                        "cXAF",
                        "USDx",
                        "EURx"
                      ],
                      "description": "Supported stablecoin"
                    },
                    "to": {
                      "type": "string",
                      "enum": [
                        "cNGN",
                        "cGHS",
                        "cXAF",
                        "USDx",
                        "EURx"
                      ],
                      "description": "Supported stablecoin"
                    },
                    "rate": {
                      "type": "string",
                      "description": "Units of `to` per 1 unit of `from`"
                    },
                    "refreshedAt": {
                      "type": "string",
                      "description": "ISO-8601 UTC timestamp"
                    }
                  },
                  "required": [
                    "from",
                    "to",
                    "rate",
                    "refreshedAt"
                  ]
                }
              }
            },
            "required": [
              "base",
              "source",
              "provider",
              "refreshedAt",
              "isStale",
              "rates"
            ]
          }
        },
        "required": [
          "message",
          "data"
        ]
      },
      "CreateWalletDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string",
            "minLength": 5,
            "maxLength": 32
          }
        },
        "additionalProperties": false
      },
      "WalletResponseDto": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "phone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "createdAt": {
                "type": "string",
                "description": "ISO-8601 UTC timestamp"
              },
              "balances": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "currency": {
                      "type": "string",
                      "enum": [
                        "cNGN",
                        "cGHS",
                        "cXAF",
                        "USDx",
                        "EURx"
                      ],
                      "description": "Supported stablecoin"
                    },
                    "available": {
                      "type": "string",
                      "description": "Exact ledger value as a decimal string, trailing zeros trimmed"
                    }
                  },
                  "required": [
                    "currency",
                    "available"
                  ]
                }
              }
            },
            "required": [
              "id",
              "email",
              "phone",
              "createdAt",
              "balances"
            ]
          }
        },
        "required": [
          "message",
          "data"
        ]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "BAD_REQUEST",
              "INVALID_ID",
              "INVALID_PHONE",
              "INVALID_CURSOR",
              "IDEMPOTENCY_KEY_REQUIRED",
              "IDEMPOTENCY_KEY_INVALID",
              "SELF_TRANSFER_NOT_ALLOWED",
              "SAME_CURRENCY_SWAP",
              "ROUTE_NOT_FOUND",
              "WALLET_NOT_FOUND",
              "RECIPIENT_NOT_FOUND",
              "TRANSACTION_NOT_FOUND",
              "WALLET_ALREADY_EXISTS",
              "IDEMPOTENCY_REQUEST_IN_PROGRESS",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "IDEMPOTENCY_KEY_REUSED",
              "INSUFFICIENT_FUNDS",
              "AMOUNT_TOO_SMALL",
              "AMOUNT_LIMIT_EXCEEDED",
              "RATE_LIMITED",
              "INTERNAL_ERROR",
              "FX_UNAVAILABLE",
              "LEDGER_INVARIANT_VIOLATION"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {}
